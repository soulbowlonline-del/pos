# ─────────────────────────────────────────────────────────────
#  POS (Yii 1.x) — .gitignore
#
#  NOTE: framework/ and ext-prod/ are bundled dependencies with no
#  package manager to restore them, so they ARE committed on purpose.
#  vendor/ is now composer-managed — restore it with `composer install`
#  (see composer.json). It is ignored below.
# ─────────────────────────────────────────────────────────────

# ── Composer dependencies (restore with `composer install`) ──
/vendor/
composer.phar

# ── Secrets / local config ──────────────────────────────────
.env
.env.*
!.env.example

# ── OS / editor cruft ───────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ── Yii runtime: logs, cache, file-based sessions ───────────
wdir/runtime/*
!wdir/runtime/.gitkeep

# ── Published assets (regenerated by Yii's asset manager) ────
assets/*
!assets/.gitkeep

# ── User uploads (runtime data, not source) ─────────────────
wdir/uploads/*
!wdir/uploads/.gitkeep
!wdir/uploads/pdf/
wdir/uploads/pdf/*
!wdir/uploads/pdf/.gitkeep
uploadbills/*
!uploadbills/.gitkeep

# ── Database dumps (but KEEP db_changes/ migration scripts) ──
*.sql
*.sql.gz
!db_changes/*.sql

# ── Large data exports / scratch files ──────────────────────
Products.txt
SBProducts*.txt
/new 1.txt

# ── Sensitive tools — must NOT ship in the repo/webroot ─────
#  DB admin consoles and info dumps are a security risk if deployed
#  publicly. Delete a line below only if you deliberately need it.
phpinfo.php
adminer.php
adminer-*.php

app2/runtime/*
!app2/runtime/.gitkeep

# Assets Yii 2 publishes at runtime from vendor/bower-asset.
v2/assets/

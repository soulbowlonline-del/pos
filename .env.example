# Copy to .env (which is gitignored) and fill in real values.
#
# Phase 0 note: the legacy app connects to MySQL as root, so DB_ROOT_PASSWORD
# must match POS_DB_PASSWORD below.

# ── docker-compose (MySQL container) ─────────────────────────
DB_ROOT_PASSWORD=changeme
DB_NAME=pos_live
DB_USER=pos_user
DB_PASSWORD=changeme

# ── App secrets (read by config/ via the .env loader in common.php) ──
POS_DB_USER=root
POS_DB_PASSWORD=changeme
POS_SMTP_PASSWORD=your-gmail-app-password
POS_INTERAKT_API_KEY=your-interakt-api-key
POS_FTP_PASSWORD=your-ftp-password
POS_SMTP_INOUT_PASSWORD=your-second-gmail-app-password

# ── AI features under /v2/ai (optional; see docs/ai-features.md) ──
# Without a key the Claude features say so and do nothing; the rule-based
# Insights page works either way and costs nothing.
ANTHROPIC_API_KEY=
# POS_AI_MODEL=claude-sonnet-5-5   (claude-opus-5-5: twice the price)
# POS_AI_BILL_FALLBACK_MODEL=claude-opus-5-5   (a bill Sonnet cannot read cleanly is read again; none = off)
# POS_AI_MONTHLY_BUDGET_USD=50
# POS_AI_ROLES=1
# POS_AI_USERS=   (usernames let in whatever their role, comma separated: sagargiri,kajalbist)

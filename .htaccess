Options +FollowSymLinks
IndexIgnore */*
RewriteEngine on

# if a directory or a file exists, use it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# /v2 is the Yii 2 application and has its own front controller.
RewriteCond %{REQUEST_URI} !^/v2

# otherwise forward it to index.php
RewriteRule . index.php
php_value max_input_vars 10000
php_value memory_limit 10240M

# Secrets and repository files that live in the web root. .env holds every
# credential the application uses; .git holds its whole history.
RedirectMatch 404 /\.git(/|$)
# Composer packages (vendor/ is gitignored, so it cannot carry its own
# .htaccess). Two levels deep, so the theme's own js/vendor/*.js still loads.
RedirectMatch 404 /vendor/[^/]+/[^/]+/
<FilesMatch "^(\.env.*|\.gitignore|composer\.(json|lock)|phpstan\.neon|docker-compose.*\.yml|.*\.md|.*\.sql|.*\.sql\.gz)$">
    Require all denied
</FilesMatch>
